{
  "name": "a-plaga",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A PRAGA — jogo 3D multiplayer inspirado no Zombie Plague 5.0 do juninmd",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "start:lan": "node scripts/lan.mjs",
    "play": "npm run build && node scripts/lan.mjs"
  },
  "dependencies": {
    "three": "^0.170.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
